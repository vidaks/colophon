# Colophon configuration
# Copy this file to .env and fill in the values, or export them in your shell environment.
# Secrets remain in the environment and are never stored in the database or log files.

# --- Book Server (Booklore / Edda / Grimmory) ---
GRIMMORY_URL=http://localhost:6060/api/v1
COLOPHON_ADMIN_USER=admin
COLOPHON_ADMIN_GROUP=admin

# Shared secret for proxy authentication (sent in the X-Edda-Proxy-Auth header).
# Required when the server requires proxy verification for Remote-User authentication.
# Leave empty if the server does not require this header.
COLOPHON_PROXY_AUTH_SECRET=

# Database container name and database name used for fast read-only snapshots:
COLOPHON_DB_CONTAINER=grimmory-db
COLOPHON_DB_NAME=grimmory

# Public web address of the book server. Used to generate links to books in summary reports.
# When unset, summary reports list book titles and IDs without hyperlinks.
# COLOPHON_BOOKSTORE_URL=https://books.example.com

# Root directory of the book library on the host filesystem.
# When set, `resolve` can inspect local EPUB files for metadata when online matching confidence is low.
# COLOPHON_BOOKS_ROOT=/path/to/books

# --- Metadata Provider (Hardcover) ---
COLOPHON_HARDCOVER_KEY=

# Alternatively, a command that accepts a GraphQL query on stdin and writes the JSON response to stdout.
# Use this when fetching the API key from an external password manager or secret store.
# COLOPHON_HARDCOVER_QUERY_CMD=/path/to/hardcover-query.sh

# --- Language Model Matching (for `resolve`) ---
# Direct API key for Anthropic. Leave unset if you authenticate using the local `claude` CLI tool.
ANTHROPIC_API_KEY=

# Number of days before retrying previously unmatched books (default: 0, which never retries).
# Books are also retried automatically if their title or author changes.
# COLOPHON_RESOLVE_RETRY_DAYS=0

# Number of failed match attempts before marking a new book as stuck (default: 6).
# Stuck books are excluded from future automated sweeps and reported for manual review.
# COLOPHON_ENRICH_STUCK_AFTER=6

# --- Local Storage ---
# Default paths: repository root when running from source, or ~/.local/state/colophon for packaged installs.
# Set explicit paths for service deployments:
# COLOPHON_DB=/var/lib/colophon/colophon.db
# COLOPHON_REPORTS=/var/lib/colophon/reports

# --- Email Notifications ---
# Used by `oversight` (when warnings or errors occur) and by `maintain --email` (daily summary).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OVERSIGHT_TO=
